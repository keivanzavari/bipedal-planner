<mujoco model="planar_biped">
  <!-- Planar biped: sagittal plane (x forward, z up), hinge axes on y.
       Geometry matches robot/config.py:RobotConfig defaults.
       Total mass ~66 kg. -->

  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom condim="3" solimp="0.9 0.95 0.001" solref="0.01 1" friction="1.0 0.005 0.0001"/>
    <motor ctrlrange="-500 500"/>
  </default>

  <worldbody>
    <!-- Pelvis: 3-DOF planar (slide x, slide z, hinge pitch).
         Body pos at origin; qpos[1] sets the actual z height. -->
    <body name="pelvis" pos="0 0 0">
      <joint name="pelvis_x" type="slide" axis="1 0 0"/>
      <joint name="pelvis_z" type="slide" axis="0 0 1"/>
      <joint name="pelvis_pitch" type="hinge" axis="0 1 0"/>
      <geom name="torso" type="box" size="0.14 0.09 0.225" mass="40" rgba="0.4 0.5 0.7 1"/>

      <!-- ========== Left leg ========== -->
      <body name="left_upper_leg" pos="0 0.10 -0.05">
        <joint name="hip_pitch_L" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
        <geom name="left_thigh" type="capsule" fromto="0 0 0  0 0 -0.40" size="0.04" mass="0.5" rgba="0.6 0.3 0.3 1"/>

        <body name="left_lower_leg" pos="0 0 -0.40">
          <joint name="knee_L" type="hinge" axis="0 1 0" range="-2.5 -0.05"/>
          <geom name="left_shin" type="capsule" fromto="0 0 0  0 0 -0.40" size="0.035" mass="0.3" rgba="0.6 0.3 0.3 1"/>

          <body name="left_foot" pos="0 0 -0.40">
            <joint name="ankle_L" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <geom name="left_foot_geom" type="box" size="0.08 0.04 0.01" pos="0.02 0 0.01" mass="0.1" rgba="0.8 0.5 0.5 1"/>
          </body>
        </body>
      </body>

      <!-- ========== Right leg ========== -->
      <body name="right_upper_leg" pos="0 -0.10 -0.05">
        <joint name="hip_pitch_R" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
        <geom name="right_thigh" type="capsule" fromto="0 0 0  0 0 -0.40" size="0.04" mass="0.5" rgba="0.3 0.3 0.6 1"/>

        <body name="right_lower_leg" pos="0 0 -0.40">
          <joint name="knee_R" type="hinge" axis="0 1 0" range="-2.5 -0.05"/>
          <geom name="right_shin" type="capsule" fromto="0 0 0  0 0 -0.40" size="0.035" mass="0.3" rgba="0.3 0.3 0.6 1"/>

          <body name="right_foot" pos="0 0 -0.40">
            <joint name="ankle_R" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <geom name="right_foot_geom" type="box" size="0.08 0.04 0.01" pos="0.02 0 0.01" mass="0.1" rgba="0.5 0.5 0.8 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="hip_pitch_L_servo"  joint="hip_pitch_L"  kp="500" kv="50" ctrlrange="-1.57 1.57" forcerange="-500 500"/>
    <position name="knee_L_servo"       joint="knee_L"       kp="500" kv="50" ctrlrange="-2.5 -0.05" forcerange="-500 500"/>
    <position name="ankle_L_servo"      joint="ankle_L"      kp="300" kv="30" ctrlrange="-0.8 0.8"   forcerange="-300 300"/>
    <position name="hip_pitch_R_servo"  joint="hip_pitch_R"  kp="500" kv="50" ctrlrange="-1.57 1.57" forcerange="-500 500"/>
    <position name="knee_R_servo"       joint="knee_R"       kp="500" kv="50" ctrlrange="-2.5 -0.05" forcerange="-500 500"/>
    <position name="ankle_R_servo"      joint="ankle_R"      kp="300" kv="30" ctrlrange="-0.8 0.8"   forcerange="-300 300"/>
  </actuator>
</mujoco>
